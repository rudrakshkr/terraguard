# ── HillSense AI · LLM configuration ────────────────────────────────────────
# Copy this file to `.env.local` and paste your key.
# The app runs WITHOUT a key in "heuristic mode" (deterministic keyword
# classification + BM25 retrieval) — every feature stays demoable.
#
# Default provider: Google Gemini (free tier) via its OpenAI-compatible layer.

# Get a free key: https://aistudio.google.com/apikey
LLM_API_KEY=

# Gemini via its OpenAI-compatibility layer (default)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Vision-capable chat model (default). Also good: gemini-2.5-flash, gemini-2.0-flash
LLM_MODEL=gemini-3.8-flash

# Embedding model for RAG (default). Falls back to local BM25 if unavailable.
LLM_EMBED_MODEL=gemini-embedding-001

# ── Using another provider instead ──────────────────────────────────────────
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini            LLM_EMBED_MODEL=text-embedding-3-small
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=<vision-capable model id>
# Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Ollama (local): LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.2-vision
#
# Notes
# - The key stays server-side (API routes only) — never exposed to the browser.
# - Gemini free tier has per-minute quotas; the app auto-chunks embedding
#   requests and falls back to BM25 retrieval on any failure.

# ── HillSense AI · Authentication (phone + OTP) ─────────────────────────────
# By default the app runs WITHOUT an SMS provider: OTP codes are shown on
# screen (dev mode) and clearly labelled as such — the app never pretends an
# SMS was delivered. To send real SMS, configure BOTH of these (adapter
# contract: POST { to, message } with Bearer auth; adjust lib/auth.ts for your
# provider's exact request shape, e.g. Twilio, MSG91, Twilio India, Vonage):

# SMS_PROVIDER_API_URL=
# SMS_PROVIDER_API_KEY=

# Force dev-mode code reveal even with a provider configured (local testing):
AUTH_DEV_MODE=1
